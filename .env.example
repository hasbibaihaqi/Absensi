PORT=3000
NODE_ENV=production
TZ=Asia/Jakarta

# Generate dengan: node -e "require('crypto').randomBytes(64,(e,b)=>console.log(b.toString('hex')))"
JWT_SECRET=GANTI_DENGAN_STRING_RANDOM_MINIMAL_64_KARAKTER

JWT_EXPIRES_IN=8h
DB_PATH=./database/absensi.sqlite

# CORS: izinkan hanya origin domain Anda (pisahkan dengan koma jika lebih dari satu)
# Contoh: https://absensi.sekolah.sch.id,https://www.sekolah.sch.id
ALLOWED_ORIGINS=https://namadomainanda.sch.id
